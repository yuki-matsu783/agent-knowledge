{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec tsx scripts/build-index.ts --quiet 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "index.jsonl を再生成中"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/protect-generated.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/lint-on-edit.sh",
            "timeout": 60,
            "statusMessage": "frontmatter を lint 中"
          }
        ]
      }
    ]
  },
  "env": {
    "ARCHIFY_UPDATE_CHECK_DISABLED": "1"
  }
}
