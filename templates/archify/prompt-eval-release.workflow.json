  "meta": {
    "title": "Prompt Change Eval and Release",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "happy-path",
        "label": "Change to release",
        "focus": [
          "author",
          "change",
          "evals",
          "judge",
          "review",
          "release"
        ],
        "note": "Follow a prompt or skill change through automated evals and human review to release."
      },
      {
        "id": "failure-loop",
        "label": "Failure loop",
        "focus": [
          "judge",
          "regressed",
          "revise"
        ],
        "note": "See where a regression stops the change and sends it back for revision."
      },
      {
        "id": "evidence",
        "label": "Evidence",
        "focus": [
          "dataset",
          "evals",
          "report"
        ],
        "note": "Isolate the eval dataset and the report that reviewers read."
      }
    ]
  },
  "lanes": [
    {
      "id": "author",
      "label": "Author"
    },
    {
      "id": "ci",
      "label": "Eval Pipeline"
    },
    {
      "id": "evidence",
      "label": "Evidence"
    },
    {
      "id": "gate",
      "label": "Gate & Recovery",
      "variant": "exception"
    }
  ],
