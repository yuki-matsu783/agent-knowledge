  "cards": [
    {
      "dot": "emerald",
      "title": "Loop shape",
      "items": [
        "The model never executes tools; the app does",
        "Each tool_use is answered with a tool_result in the next request"
      ]
    },
    {
      "dot": "rose",
      "title": "Policy",
      "items": [
        "Permission check happens between tool_use and execution",
        "A denied call is returned to the model as an error tool_result"
      ]
    },
    {
      "dot": "orange",
      "title": "Observability",
      "items": [
        "Usage and latency are emitted asynchronously",
        "The trace never blocks the final answer"
